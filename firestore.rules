rules_version = '2';

/* 미니홈피 보안 규칙입니다.

   핵심 개념: "주인장(ownerUid)" 은 site/content 문서에 딱 한 번 기록됩니다.
   - 아직 주인이 없으면, 로그인한 사람이 자기 uid 로 한 번 등록할 수 있습니다.
     (배포 직후 주인장이 바로 등록해야 합니다. 먼저 누른 사람이 주인이 됩니다.)
   - 한 번 정해진 ownerUid 는 그 뒤로 아무도 바꿀 수 없습니다.
   - 사이트 내용 수정과 사진 업로드는 주인장만 할 수 있습니다.

   방명록은 반대로 "로그인한 누구나" 쓸 수 있고, 지우는 것만 본인/주인장으로 막습니다. */
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerUid() {
      return exists(/databases/$(database)/documents/site/content)
        ? get(/databases/$(database)/documents/site/content).data.get('ownerUid', '')
        : '';
    }

    function isOwner() {
      return request.auth != null && ownerUid() != '' && request.auth.uid == ownerUid();
    }

    /* 사이트 내용: 소개 문구, 탭 목록, 각 탭의 글·사진·링크, 게시판 글 */
    match /site/content {
      allow read: if true;

      /* 최초 1회 주인 등록. 자기 uid 로만 만들 수 있습니다. */
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      /* 그 뒤로는 주인장만, 그리고 ownerUid 는 못 바꿉니다. */
      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if false;
    }

    /* 주인장이 올린 사진입니다. 문서 하나에 한 장씩 base64 로 들어 있습니다. */
    match /images/{imageId} {
      allow read: if true;
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['dataUrl'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 900000;
      allow update: if false;
      allow delete: if isOwner();
    }

    /* 방명록입니다.

       - 공개글은 누구나 읽습니다.
       - 비밀글은 쓴 본인과 주인장만 읽습니다.
       - 쓰기는 구글 로그인을 한 사람만 (스팸 방지).
       - 수정은 불가. 삭제는 본인 글이거나 주인장일 때만. */
    match /guestbook/{entryId} {
      allow read: if resource.data.get('secret', false) == false
        || (request.auth != null && request.auth.uid == resource.data.uid)
        || isOwner();

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['author', 'text', 'approved', 'createdAt', 'uid', 'secret'])
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 1
        && request.resource.data.author.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 100
        && request.resource.data.approved == true
        && request.resource.data.secret is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.uid == request.auth.uid;

      allow update: if false;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.uid || isOwner());

      /* 댓글. 원글을 볼 수 있는 사람이면 댓글도 봅니다.
         쓰기는 로그인한 사람, 삭제는 본인 댓글이거나 주인장. */
      match /replies/{replyId} {
        function parent() {
          return get(/databases/$(database)/documents/guestbook/$(entryId)).data;
        }

        allow read: if parent().get('secret', false) == false
          || (request.auth != null && request.auth.uid == parent().uid)
          || isOwner();

        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['author', 'text', 'uid', 'createdAt'])
          && request.resource.data.author is string
          && request.resource.data.author.size() >= 1
          && request.resource.data.author.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 100
          && request.resource.data.createdAt == request.time
          && request.resource.data.uid == request.auth.uid;

        allow update: if false;
        allow delete: if request.auth != null
          && (request.auth.uid == resource.data.uid || isOwner());
      }
    }

    /* 낙서장(오에카키). progh2/mini-homepage 규칙을 가져와 (MIT) 이 파일의
       isOwner() 에 맞췄습니다.

       - 목록 문서: uid, author, comment, hidden, createdAt. 그림은 안 들어갑니다.
       - 그림 본체: oekaki/{id}/image/data (base64 PNG, 300000자 이하)
       - 그리는 과정: oekaki/{id}/replay/data (400000자 이하)
       - 댓글: oekaki/{id}/comments
       - 주인장은 hidden 한 칸만 바꿔 가릴 수 있습니다. 가려지면 주인장 외에는
         그림·과정도 못 읽습니다. */
    match /oekaki/{drawingId} {
      function canDelete() {
        return request.auth != null
          && (resource.data.uid == request.auth.uid || isOwner());
      }
      function parentHidden() {
        return get(/databases/$(database)/documents/oekaki/$(drawingId)).data.hidden;
      }

      allow read: if resource.data.hidden == false || isOwner();

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'author', 'comment', 'hidden', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 1
        && request.resource.data.author.size() <= 50
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 60
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time;

      /* 가리기: 주인장만, hidden 한 칸만. */
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
        && request.resource.data.hidden is bool;

      /* 예전 형식 정리: 문서 안의 image 를 빼는 것만 허용. */
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['image'])
        && !('image' in request.resource.data);

      allow delete: if canDelete();

      match /image/{docId} {
        allow read: if parentHidden() == false || isOwner();
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'image'])
          && (request.resource.data.uid == request.auth.uid || isOwner())
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 300000
          && request.resource.data.image[0:22] == 'data:image/png;base64,';
        allow update: if false;
        allow delete: if canDelete();
      }

      match /replay/{docId} {
        allow read: if parentHidden() == false || isOwner();
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'ops', 'count', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.ops is string
          && request.resource.data.ops.size() <= 400000
          && request.resource.data.count is int
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if canDelete();
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'author', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.author is string
          && request.resource.data.author.size() >= 1
          && request.resource.data.author.size() <= 50
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 100
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if canDelete();
      }
    }

    /* 미니홈피 왼쪽 위 TODAY / TOTAL 방문 수입니다. 문서 하나만 씁니다.

       - 한 번에 total 을 1씩만 올릴 수 있습니다
       - 날짜(day)가 바뀐 첫 방문이면 today 는 1로 돌아갑니다
       - 필드는 total, today, day 세 개만 허용하고 삭제는 막습니다 */
    match /counters/site {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['total', 'today', 'day'])
        && request.resource.data.total == 1
        && request.resource.data.today == 1
        && request.resource.data.day is string;

      allow update: if request.resource.data.keys().hasOnly(['total', 'today', 'day'])
        && request.resource.data.total is int
        && request.resource.data.today is int
        && request.resource.data.day is string
        && request.resource.data.total == resource.data.total + 1
        && (
          (request.resource.data.day == resource.data.day
            && request.resource.data.today == resource.data.today + 1)
          || (request.resource.data.day != resource.data.day
            && request.resource.data.today == 1)
        );

      allow delete: if false;
    }

    /* 그 밖의 모든 경로는 차단합니다. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
